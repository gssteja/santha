      </intent-filter>
      <intent-filter>
        <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"/>
      </intent-filter>
      <meta-data android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" android:resource="@xml/rtlsdr_device_filter"/>
    </activity>
    <service android:name="expo.modules.rtlradio.RadioService" android:exported="false" android:foregroundServiceType="mediaPlayback"/>
  </application>
</manifest>
