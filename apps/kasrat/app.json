{
  "expo": {
    "name": "Kasrat",
    "slug": "kasrat",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "kasrat",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d0d10"
    },
    "android": {
      "package": "com.santha.kasrat",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d0d10"
      }
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
